# /opt/law_helper/.env.example —— 模板文件，可入仓库
# 真实 .env 不要入仓库，手动在服务器上创建

# 阿里云百炼 LLM 配置
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-你的百炼API密钥
LLM_MODEL=qwen3.8-flash

# OCR 模型
OCR_MODEL=qwen3.5-ocr
OCR_DPI=200

# 数据与存储
DOCX_PATH=中华人民共和国道路交通安全法_20210429.docx
CHROMA_DIR=chroma

# Embedding / Rerank 模型
EMBEDDING_MODEL_ID=qwen3.7-text-embedding
RERANK_MODEL_ID=qwen3.7-text-rerank
EMBEDDING_DIMENSIONS=1024

# 检索参数
TOP_K_RETRIEVE=10
BM25_WEIGHT=0.5
RRF_LAMBDA=60
RERANK_TOP_N=3

# 服务
BACKEND_URL=http://127.0.0.1:8000

# 会话 Cookie 签名密钥（必填，随机 64 位 hex）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=替换为随机64位hex字符串

# CORS（生产环境用 nginx 同源反代，CORS 基本不触发；预留配置）
# 若拿到域名：CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=*

# 单用户模式（个人部署保持 True）
SINGLE_USER_MODE=True
