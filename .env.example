# ===== 必填 =====

# 阿里云百炼 API Key（OpenAI 兼容接口）
OPENAI_API_KEY=

# DashScope 原生 SDK API Key（EMBEDDING_BACKEND=dashscope 时使用；不配置则复用 OPENAI_API_KEY）
# DASHSCOPE_API_KEY=

# 会话 Cookie 加密密钥（必填，任意随机字符串）
SESSION_SECRET_KEY=please-change-me-to-a-random-secret

# Embedding 后端与模型（无代码默认值，必须显式配置）
#   api       -> 通过阿里云百炼 OpenAI 兼容接口调用
#   dashscope -> 通过 DashScope 原生 SDK 调用（支持 qwen3-vl-embedding 等）
#   local     -> 本地 sentence-transformers 模型（离线/零 token）
EMBEDDING_BACKEND=api

# Embedding 模型 ID（api / dashscope 模式必填）
EMBEDDING_MODEL_ID=qwen3.7-text-embedding

# 嵌入向量维度（非 local 模式由模型规格决定）
EMBEDDING_DIMENSIONS=1024

# ===== 常用可选项 =====

# LLM 接口地址与模型
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 重排模型
RERANK_MODEL_ID=qwen3.7-text-rerank

# OCR 模型（扫描型 PDF 兜底）
OCR_MODEL=qwen3.5-ocr

# 本地嵌入模型（仅 EMBEDDING_BACKEND=local 时使用）
# EMBEDDING_LOCAL_MODEL=BAAI/bge-base-zh-v1.5

# CORS 允许来源（逗号分隔）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 人机验证（Cloudflare Turnstile，可选）=====
# SITE_KEY 与 SECRET_KEY 同时配置才启用；两项均留空 = 关闭验证。
# 紧急停用验证：把这两个值同时清空即可（纯服务端生效，客户端无法伪造）。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 前端 hostname 白名单（逗号分隔），生产建议配置；留空则跳过该校验
# TURNSTILE_HOSTNAMES=lawhelper.xyz
# 验证脚本地址（逗号分隔可配多个，按顺序回退，首个为主源）；留空用内置默认源。
# 由后端下发而非前端硬编码：更换验证域名时无需重新构建并上传前端产物。
# 内置默认源：https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit
# TURNSTILE_SCRIPT_SRC=
