# 部署期配置（服务器本地维护，不随代码分发）
#
# 用法：
#   cp deploy.env.example deploy.env
#   vi deploy.env    # 填入下方变量
#
# 本文件已被 .gitignore 与 .dockerignore 同时排除：
#   - 不会入库
#   - 不会被意外打进镜像层
# 请勿在此写入任何密钥——ACR 凭证由服务器上的 docker login 单独管理。

# ACR 镜像仓库地址（不含命名空间与仓库名）
# 公网地址形如 registry.<region>.aliyuncs.com
# 若 ACR 提供了 VPC 内网地址（形如 registry-vpc.<region>.aliyuncs.com）且 ECS 与之同地域，
# 优先填内网地址：免公网流量费且更快。
# 是否提供内网地址请以 ACR 控制台实际显示为准，不要凭猜测填写。
ACR_REGISTRY_HOST=registry.cn-hangzhou.aliyuncs.com

# ACR 命名空间
ACR_NAMESPACE=your-namespace

# 镜像仓库名，需与 GitHub Actions 推送的仓库名一致
BACKEND_IMAGE_REPO=law-helper-backend

# 说明：镜像标签不在此配置。
#   正式部署使用 latest；
#   需要回滚时在命令行指定：
#     IMAGE_TAG=<git-sha> bash deploy.sh
