# 环境与密钥
.env
.env.*
!.env.example

# 部署期配置（ACR 地址/命名空间等，服务器本地维护）
# 注意：上面的 .env.* 通配不匹配 deploy.env，必须单独列出
deploy.env

# 证书与私钥（敏感，不入仓库；正式证书仅存放于服务器 /etc/letsencrypt）
*.pem
*.key
*.crt
*.p12

# 调试脚本
_debug_*.py
.trae/

# 可视测面板
dashboard.html

# AI 助手本地权限配置
settings.json
.claude/

# AI 助手项目数据（计划文档等，不入仓库，本地保留）
.codebuddy/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 运行时数据
models/
data/
logs/
*.log

# 前端
node_modules/
dist/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# IDE
.idea/
.vscode/

