# 本地推送配置（仅存本机，不随代码分发）
#
# 用法：
#   cp push.env.example push.env
#   vi push.env      # 填入下方变量
#
# 本文件对应的实际文件 push.env 已被 .gitignore 排除：
#   - 不会入库
#   - 不会被意外打进镜像层（Dockerfile 用 COPY 指定目录，本文件本就不在构建上下文拷贝范围内）
# 请勿在此写入任何密钥——ACR 凭证由本机 docker login 单独管理（写入 ~/.docker/config.json）。

# ACR 镜像仓库地址（不含命名空间与仓库名）
# 公网地址形如 registry.<region>.aliyuncs.com
# 本地构建推送走公网地址即可（VPC 内网地址仅服务器与 ACR 同地域时才有意义）。
ACR_REGISTRY_HOST=registry.cn-hangzhou.aliyuncs.com

# ACR 命名空间
ACR_NAMESPACE=your-namespace

# 镜像仓库名，需与服务器 deploy.env 及 CI 推送的仓库名一致
BACKEND_IMAGE_REPO=law-helper-backend

# 说明：镜像标签不在此配置，由 push_image.ps1 自动生成：
#   - <完整 40 位 commit sha>：与 CI、deploy.sh 回滚约定一致
#   - latest：正式部署使用的移动标签，最后推送
